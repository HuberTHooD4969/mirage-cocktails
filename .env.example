# Server Environment
PORT=3000
NODE_ENV=development

# Admin Credentials
ADMIN_USER=admin
ADMIN_PASS=change_this_to_a_strong_password
ADMIN_EMAIL=admin@example.com

# JWT Signing Key (64-character hex key)
JWT_SECRET=change_this_to_a_64_char_hex_string

# Paystack Payment System (GHS Currency)
# Get your keys at https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_SUBACCOUNT=ACCT_your_subaccount_code_here

# Email (Nodemailer SMTP - Gmail, SendGrid, etc.)
# Leave empty to keep file-only logging
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Mirage Cocktails" <noreply@miragecocktails.com>

# SMS Gateway (Generic HTTP API)
# Leave empty to keep file-only logging
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=Mirage
